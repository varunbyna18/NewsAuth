# AI-Powered News Verification System - Environment Variables

# ========== BACKEND ==========
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
DEBUG=false

# ========== AZURE COGNITIVE SERVICES ==========
# Get these from Azure Portal -> Text Analytics Resource
AZURE_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com/
AZURE_KEY=YOUR_AZURE_KEY_HERE

# ========== PINATA IPFS ==========
# Get these from https://app.pinata.cloud
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET=YOUR_PINATA_SECRET_KEY

# ========== ETHEREUM SEPOLIA ==========
# RPC URL from Infura, Alchemy, or your own node
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private key for smart contract deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Contract address (auto-updated after deployment)
CONTRACT_ADDRESS=0x

# ========== ETHERSCAN ==========
# For contract verification on Etherscan
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ========== AZURE DEPLOYMENT ==========
# Use these for Azure App Service deployment
AZURE_RESOURCE_GROUP=newsauth-rg
AZURE_APP_SERVICE_NAME=newsauth-api
AZURE_STATIC_WEB_APPS_NAME=newsauth-frontend

# ========== DATABASE (Optional) ==========
# For storing analysis records and user data
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/newsauth
# or for Cosmos DB
COSMOS_CONNECTION_STRING=

# ========== LOGGING ==========
# Application Insights connection string for Azure monitoring
APPLICATION_INSIGHTS_CONNECTION_STRING=InstrumentationKey=YOUR_KEY

# ========== SECURITY ==========
# JWT Secret for authentication (optional)
JWT_SECRET=your_jwt_secret_here

# API rate limiting (requests per minute)
RATE_LIMIT=100

# ========== FRONTEND CONFIG ==========
# These will be included in frontend .env.local
VITE_API_URL=http://localhost:5000
VITE_CONTRACT_ADDRESS=0x
